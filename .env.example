# AWS Credentials for CloudWatch Module
# .env 파일을 생성하고 아래 값들을 실제 AWS 자격 증명으로 채워주세요

# AWS Access Key ID
AWS_ACCESS_KEY_ID=your-access-key-id-here

# AWS Secret Access Key
AWS_SECRET_ACCESS_KEY=your-secret-access-key-here

# AWS Default Region
AWS_DEFAULT_REGION=your-default_region-here

# Optional: AWS Session Token (임시 자격 증명 사용시)
# AWS_SESSION_TOKEN=your-session-token-here
